{
  "name": "marktree",
  "private": true,
  "version": "0.1.0",
  "description": "A source-faithful local Markdown and text workspace with optional Git.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-bindings.mjs --check && vue-tsc -b && vite build",
    "generate:bindings": "node scripts/generate-bindings.mjs",
    "preview": "vite preview",
    "test:visual": "node scripts/visual-check.mjs",
    "test": "node scripts/generate-bindings.mjs --check && vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "check:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:android-rust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-android-rust.ps1",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build:debug": "tauri android build --debug --apk"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/markdown": "^1.6.3",
    "codemirror": "^6.0.2",
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-os": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "diff": "^8.0.2",
    "katex": "^0.16.22",
    "lucide-vue-next": "^0.577.0",
    "mermaid": "^11.12.0",
    "vue": "^3.5.30",
    "vue-i18n": "^11.1.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/diff": "^7.0.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "jsdom": "^28.0.0",
    "playwright-core": "^1.55.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
  }
}
